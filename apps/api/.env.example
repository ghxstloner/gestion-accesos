# ── Application ──
NODE_ENV=development
PORT=4000

# ── Database (MySQL 8 via Docker Compose) ──
DATABASE_URL="mysql://root:root@localhost:3306/sga_dev"
DATABASE_URL_TEST="mysql://root:root@localhost:3306/sga_test"

# ── Authentication ──
JWT_ACCESS_SECRET=change-me-access-secret-in-production
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Security ──
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost

# ── File storage ──
STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760

# ── AITSA API (consulta de empresas / Intelisis) ──
# Pruebas: http://172.31.254.69/JWTServicios — credenciales en el documento
# "V1-AITSA-API-EMPRESAS" (Gerencia de TIC de AITSA). No versionar valores reales.
AITSA_API_BASE_URL=http://172.31.254.69/JWTServicios
AITSA_API_CLIENT_ID=
AITSA_API_SECRET=
AITSA_API_TIMEOUT_MS=15000
# Sincronización programada (diaria por defecto a las 03:15)
AITSA_SYNC_ENABLED=false
AITSA_SYNC_CRON="15 3 * * *"
